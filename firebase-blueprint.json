{
  "entities": {
    "Workspace": {
      "title": "Workspace",
      "description": "Shared private couple workspace owned by exactly two partner accounts sharing the same password.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique box identifier (either claimed legacy box or random box_<24hex>).",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase Auth UID of the primary signup creator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberUids": {
          "type": "array",
          "description": "Fixed 2-element list of the two partner UIDs allowed to access this shared workspace."
        },
        "legacyClaimPinToken": {
          "type": "string",
          "description": "Optional SHA-256 authorization token required only when claiming the legacy pre-auth box.",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "relationshipType": {
          "type": "string",
          "description": "Relationship profile mode chosen at signup ('ex', 'spouse', or 'couple').",
          "enum": ["ex", "spouse", "couple"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server-authoritative timestamp when the couple workspace was registered."
        }
      },
      "required": ["id", "ownerUid", "memberUids", "relationshipType", "createdAt"]
    },
    "UserWorkspace": {
      "title": "UserWorkspace",
      "description": "Private PII-isolated mapping from each Firebase Auth UID to their shared workspace, profile names, birthdays, and relationship mode.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "boxId": {
          "type": "string",
          "description": "Shared couple workspace identifier.",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^box_[a-f0-9]{24}$"
        },
        "selfEmail": {
          "type": "string",
          "description": "Email address of this signed-in member.",
          "minLength": 3,
          "maxLength": 160
        },
        "partnerEmail": {
          "type": "string",
          "description": "Email address of the linked partner sharing the same password and workspace.",
          "minLength": 3,
          "maxLength": 160
        },
        "selfName": {
          "type": "string",
          "description": "Display name of this signed-in member.",
          "minLength": 1,
          "maxLength": 60
        },
        "partnerName": {
          "type": "string",
          "description": "Display name of the linked partner.",
          "minLength": 1,
          "maxLength": 60
        },
        "selfBirthday": {
          "type": "string",
          "description": "Birthday date (YYYY-MM-DD) of this member.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "partnerBirthday": {
          "type": "string",
          "description": "Birthday date (YYYY-MM-DD) of the linked partner.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "relationshipType": {
          "type": "string",
          "description": "Relationship profile mode ('ex', 'spouse', or 'couple').",
          "enum": ["ex", "spouse", "couple"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server-authoritative timestamp when the workspace link was created."
        }
      },
      "required": [
        "uid",
        "boxId",
        "selfEmail",
        "partnerEmail",
        "selfName",
        "partnerName",
        "selfBirthday",
        "partnerBirthday",
        "relationshipType",
        "createdAt"
      ]
    },
    "ChirkutNote": {
      "title": "ChirkutNote",
      "description": "A persistent handwritten letter/note exchanged between the two partners inside their Chirkut Box.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique document ID for the note.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "boxId": {
          "type": "string",
          "description": "Shared workspace identifier.",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sender": {
          "type": "string",
          "description": "Author display role ('আমি' or 'চাঁদ').",
          "enum": ["আমি", "চাঁদ"],
          "minLength": 1,
          "maxLength": 20
        },
        "message": {
          "type": "string",
          "description": "The text content of the handwritten chirkut note.",
          "minLength": 1,
          "maxLength": 1500
        },
        "mood": {
          "type": "string",
          "description": "Optional emotional mood label attached to the note.",
          "minLength": 1,
          "maxLength": 32
        },
        "pinToken": {
          "type": "string",
          "description": "SHA-256 authorization digest derived from the write PIN or workspace key.",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "type": "string",
          "description": "Lifecycle state used for soft-deletion.",
          "enum": ["active", "deleted"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server-authoritative timestamp when the note was saved."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server-authoritative timestamp when the note was edited or marked deleted."
        }
      },
      "required": ["id", "boxId", "sender", "message", "pinToken", "createdAt"]
    },
    "MediaAsset": {
      "title": "MediaAsset",
      "description": "Metadata for uploaded photos, voice conversations, and songs stored in Cloudinary and indexed in Cloud Firestore per couple workspace.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique document ID for the media item.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "boxId": {
          "type": "string",
          "description": "Shared workspace identifier.",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "kind": {
          "type": "string",
          "description": "Media category.",
          "enum": ["photo", "voice", "song"]
        },
        "playlistKind": {
          "type": "string",
          "description": "Playlist target when kind is 'song'.",
          "enum": ["normal", "birthday"]
        },
        "title": {
          "type": "string",
          "description": "Display title in Bengali or English.",
          "minLength": 1,
          "maxLength": 120
        },
        "subtitle": {
          "type": "string",
          "description": "Optional subtitle or artist note.",
          "minLength": 1,
          "maxLength": 120
        },
        "dateLabel": {
          "type": "string",
          "description": "Optional memory date label for photos.",
          "minLength": 1,
          "maxLength": 60
        },
        "location": {
          "type": "string",
          "description": "Optional memory location label for photos.",
          "minLength": 1,
          "maxLength": 80
        },
        "caption": {
          "type": "string",
          "description": "Optional memory caption for photos.",
          "minLength": 1,
          "maxLength": 500
        },
        "aspect": {
          "type": "string",
          "description": "Photo aspect hint.",
          "enum": ["portrait", "landscape", "square"]
        },
        "url": {
          "type": "string",
          "description": "Secure Cloudinary HTTPS delivery URL.",
          "minLength": 16,
          "maxLength": 500,
          "pattern": "^https:\\/\\/res\\.cloudinary\\.com\\/[a-zA-Z0-9_\\-]+\\/.*$"
        },
        "publicId": {
          "type": "string",
          "description": "Cloudinary public_id used for signed deletion.",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^vtr\\/[a-z]+\\/[a-zA-Z0-9_\\-]+$"
        },
        "resourceType": {
          "type": "string",
          "description": "Cloudinary resource_type ('image' or 'video').",
          "enum": ["image", "video"]
        },
        "sizeBytes": {
          "type": "integer",
          "description": "Uploaded file size in bytes.",
          "minimum": 1,
          "maximum": 35000000
        },
        "durationSec": {
          "type": "number",
          "description": "Optional audio duration in seconds.",
          "minimum": 0,
          "maximum": 7200
        },
        "status": {
          "type": "string",
          "description": "Lifecycle state used to gate verified deletion.",
          "enum": ["active", "deleted"]
        },
        "pinToken": {
          "type": "string",
          "description": "SHA-256 authorization digest derived from the write PIN or workspace key.",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server-authoritative timestamp when the media item was created."
        }
      },
      "required": [
        "id",
        "boxId",
        "kind",
        "title",
        "url",
        "publicId",
        "resourceType",
        "sizeBytes",
        "status",
        "pinToken",
        "createdAt"
      ]
    },
    "SongLyrics": {
      "title": "SongLyrics",
      "description": "Persistent AI-extracted or grounded song lyrics linked to a song in the workspace playlist.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Matching media asset ID for cloud songs or deterministic local_song hash ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "boxId": {
          "type": "string",
          "description": "Shared workspace identifier.",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "songTitle": {
          "type": "string",
          "description": "Resolved song title.",
          "minLength": 1,
          "maxLength": 160
        },
        "artist": {
          "type": "string",
          "description": "Optional artist name or subtitle.",
          "maxLength": 160
        },
        "sourceType": {
          "type": "string",
          "description": "How lyrics were obtained.",
          "enum": ["audio", "search"]
        },
        "instrumental": {
          "type": "boolean",
          "description": "Whether the track is purely instrumental."
        },
        "langMode": {
          "type": "string",
          "description": "Script formatting version (bn-hinglish-en-v2).",
          "enum": ["bn-hinglish-en-v2"]
        },
        "lines": {
          "type": "array",
          "description": "Timed lyric lines (max 220 entries)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server-authoritative timestamp when the lyrics were cached."
        }
      },
      "required": [
        "id",
        "boxId",
        "songTitle",
        "sourceType",
        "instrumental",
        "langMode",
        "lines",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/chirkut_boxes/{boxId}": {
      "schema": { "$ref": "#/entities/Workspace" },
      "description": "Immutable 2-member couple workspace ownership registry."
    },
    "/user_workspaces/{uid}": {
      "schema": { "$ref": "#/entities/UserWorkspace" },
      "description": "PII-isolated per-user link mapping Firebase Auth UID to their shared couple boxId."
    },
    "/chirkut_boxes/{boxId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/ChirkutNote" },
      "description": "Handwritten notes exchanged inside a couple's shared Chirkut Box."
    },
    "/chirkut_boxes/{boxId}/media/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaAsset" },
      "description": "Couple-scoped Cloudinary media metadata for photos, voice conversations, and songs."
    },
    "/chirkut_boxes/{boxId}/song_lyrics/{lyricsId}": {
      "schema": { "$ref": "#/entities/SongLyrics" },
      "description": "Cached timed song lyrics scoped to the couple's workspace."
    }
  }
}
