# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional backup Gemini API keys for automatic failover when free-tier quota is reached:
# GEMINI_API_KEY_2=""
# GEMINI_API_KEY_3=""
# GEMINI_API_KEYS=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cloudinary Free Media Storage (Photos, Songs, Conversations)
# Configure these three secrets in AI Studio Settings > Secrets.
CLOUDINARY_CLOUD_NAME="MY_CLOUDINARY_CLOUD_NAME"
CLOUDINARY_API_KEY="MY_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="MY_CLOUDINARY_API_SECRET"

# ElevenLabs Cloned Voice Model (Voice Chat Mode)
# Configure these in AI Studio Settings > Secrets.
ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"
ELEVENLABS_VOICE_ID="MY_ELEVENLABS_DEFAULT_VOICE_ID"

# Noiz.ai Voice Model (Voice Chat Mode)
NOIZ_API_KEY="MY_NOIZ_API_KEY"
NOIZ_VOICE_ID="MY_NOIZ_VOICE_ID"

# Optional Default Gemini TTS Voice Name/ID (e.g., Puck, Kore, Charon, Fenrir, Zephyr)
# GEMINI_VOICE_ID="Puck"

