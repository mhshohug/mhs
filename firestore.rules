rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthorizedLegacyBox(boxId) {
      return boxId == 'box_e9c02e53afeeb0a4010beaff';
    }

    function isAuthorizedWriteToken(token) {
      return token is string &&
        token.size() == 64 &&
        token == '7f779a24be5918e7543dc0687225c9e0a61a58f15174c5e9bb54ff0cf61649e0';
    }

    function isValidPinTokenFormat(token) {
      return token is string &&
        token.size() == 64 &&
        token.matches('^[a-f0-9]{64}$');
    }

    function isValidBoxWriteToken(boxId, token) {
      return isAuthorizedLegacyBox(boxId)
        ? isAuthorizedWriteToken(token)
        : isValidPinTokenFormat(token);
    }

    function isValidMemberUidsList(uids) {
      return uids is list &&
        uids.size() == 2 &&
        uids[0] is string &&
        uids[0].size() >= 1 &&
        uids[0].size() <= 128 &&
        uids[1] is string &&
        uids[1].size() >= 1 &&
        uids[1].size() <= 128 &&
        uids[0] != uids[1];
    }

    function isValidRelationshipType(val) {
      return val is string && (val == 'ex' || val == 'spouse' || val == 'couple');
    }

    function isValidDateString(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isBoxMember(boxId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/chirkut_boxes/$(boxId)) &&
        (request.auth.uid in get(/databases/$(database)/documents/chirkut_boxes/$(boxId)).data.memberUids);
    }

    function isValidWorkspaceCreate(data, boxId) {
      return data.keys().hasAll(['id', 'ownerUid', 'memberUids', 'relationshipType', 'createdAt']) &&
        data.keys().hasOnly(['id', 'ownerUid', 'memberUids', 'relationshipType', 'legacyClaimPinToken', 'createdAt']) &&
        data.id is string &&
        data.id == boxId &&
        data.id.size() >= 4 &&
        data.id.size() <= 64 &&
        data.ownerUid is string &&
        data.ownerUid == request.auth.uid &&
        isValidMemberUidsList(data.memberUids) &&
        (request.auth.uid in data.memberUids) &&
        isValidRelationshipType(data.relationshipType) &&
        data.createdAt == request.time &&
        (
          (
            isAuthorizedLegacyBox(boxId) &&
            ('legacyClaimPinToken' in data) &&
            isAuthorizedWriteToken(data.legacyClaimPinToken)
          ) ||
          (
            !isAuthorizedLegacyBox(boxId) &&
            boxId.matches('^box_[a-f0-9]{24}$') &&
            !('legacyClaimPinToken' in data)
          )
        );
    }

    function isValidUserWorkspaceCreate(data, uid) {
      return data.keys().hasAll([
          'uid',
          'boxId',
          'selfEmail',
          'partnerEmail',
          'selfName',
          'partnerName',
          'selfBirthday',
          'partnerBirthday',
          'relationshipType',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'boxId',
          'selfEmail',
          'partnerEmail',
          'selfName',
          'partnerName',
          'selfBirthday',
          'partnerBirthday',
          'relationshipType',
          'createdAt'
        ]) &&
        data.uid is string &&
        data.uid == uid &&
        data.uid == request.auth.uid &&
        data.boxId is string &&
        data.boxId.size() >= 4 &&
        data.boxId.size() <= 64 &&
        data.boxId.matches('^box_[a-f0-9]{24}$') &&
        data.selfEmail is string &&
        data.selfEmail.size() >= 3 &&
        data.selfEmail.size() <= 160 &&
        data.partnerEmail is string &&
        data.partnerEmail.size() >= 3 &&
        data.partnerEmail.size() <= 160 &&
        data.selfEmail != data.partnerEmail &&
        data.selfName is string &&
        data.selfName.size() >= 1 &&
        data.selfName.size() <= 60 &&
        data.partnerName is string &&
        data.partnerName.size() >= 1 &&
        data.partnerName.size() <= 60 &&
        isValidDateString(data.selfBirthday) &&
        isValidDateString(data.partnerBirthday) &&
        isValidRelationshipType(data.relationshipType) &&
        data.createdAt == request.time;
    }

    function isValidChirkutFields(data, boxId, noteId) {
      return data.id is string &&
        data.id.size() >= 1 &&
        data.id.size() <= 128 &&
        data.id == noteId &&
        data.boxId is string &&
        data.boxId.size() >= 4 &&
        data.boxId.size() <= 64 &&
        data.boxId == boxId &&
        data.sender is string &&
        data.sender.size() >= 1 &&
        data.sender.size() <= 20 &&
        (data.sender == 'আমি' || data.sender == 'চাঁদ' || data.sender == 'রুপো') &&
        data.message is string &&
        data.message.size() >= 1 &&
        data.message.size() <= 1500 &&
        (!('mood' in data) || (data.mood is string && data.mood.size() >= 1 && data.mood.size() <= 32)) &&
        isValidBoxWriteToken(boxId, data.pinToken);
    }

    function isValidChirkutNoteCreate(data, boxId, noteId) {
      return data.keys().hasAll(['id', 'boxId', 'sender', 'message', 'pinToken', 'createdAt']) &&
        data.keys().hasOnly(['id', 'boxId', 'sender', 'message', 'mood', 'status', 'pinToken', 'createdAt']) &&
        isValidChirkutFields(data, boxId, noteId) &&
        (!('status' in data) || data.status == 'active') &&
        data.createdAt == request.time;
    }

    function isValidChirkutNoteUpdate(nextData, prevData, boxId, noteId) {
      return nextData.keys().hasAll(['id', 'boxId', 'sender', 'message', 'pinToken', 'createdAt', 'updatedAt']) &&
        nextData.keys().hasOnly(['id', 'boxId', 'sender', 'message', 'mood', 'status', 'pinToken', 'createdAt', 'updatedAt']) &&
        isValidChirkutFields(nextData, boxId, noteId) &&
        nextData.id == prevData.id &&
        nextData.boxId == prevData.boxId &&
        nextData.createdAt == prevData.createdAt &&
        nextData.updatedAt == request.time &&
        (!('status' in prevData) || prevData.status == 'active') &&
        (
          (
            (!('status' in nextData) || nextData.status == 'active') &&
            nextData.diff(prevData).affectedKeys().hasOnly(['sender', 'message', 'mood', 'pinToken', 'updatedAt'])
          ) ||
          (
            nextData.status == 'deleted' &&
            nextData.diff(prevData).affectedKeys().hasOnly(['status', 'pinToken', 'updatedAt'])
          )
        );
    }

    function isValidMediaAssetCreate(data, boxId, mediaId) {
      return data.keys().hasAll([
          'id',
          'boxId',
          'kind',
          'title',
          'url',
          'publicId',
          'resourceType',
          'sizeBytes',
          'status',
          'pinToken',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'boxId',
          'kind',
          'playlistKind',
          'title',
          'subtitle',
          'dateLabel',
          'location',
          'caption',
          'aspect',
          'url',
          'publicId',
          'resourceType',
          'sizeBytes',
          'durationSec',
          'status',
          'pinToken',
          'createdAt'
        ]) &&
        data.id is string &&
        data.id.size() >= 1 &&
        data.id.size() <= 128 &&
        data.id == mediaId &&
        data.boxId is string &&
        data.boxId.size() >= 4 &&
        data.boxId.size() <= 64 &&
        data.boxId == boxId &&
        data.kind is string &&
        (data.kind == 'photo' || data.kind == 'voice' || data.kind == 'song') &&
        (!('playlistKind' in data) || (data.playlistKind is string && (data.playlistKind == 'normal' || data.playlistKind == 'birthday'))) &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 120 &&
        (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() >= 1 && data.subtitle.size() <= 120)) &&
        (!('dateLabel' in data) || (data.dateLabel is string && data.dateLabel.size() >= 1 && data.dateLabel.size() <= 60)) &&
        (!('location' in data) || (data.location is string && data.location.size() >= 1 && data.location.size() <= 80)) &&
        (!('caption' in data) || (data.caption is string && data.caption.size() >= 1 && data.caption.size() <= 500)) &&
        (!('aspect' in data) || (data.aspect is string && (data.aspect == 'portrait' || data.aspect == 'landscape' || data.aspect == 'square'))) &&
        data.url is string &&
        data.url.size() >= 16 &&
        data.url.size() <= 500 &&
        data.url.matches('^https:\\/\\/res\\.cloudinary\\.com\\/[a-zA-Z0-9_\\-]+\\/.*$') &&
        data.publicId is string &&
        data.publicId.size() >= 3 &&
        data.publicId.size() <= 200 &&
        data.publicId.matches('^vtr\\/[a-z]+\\/[a-zA-Z0-9_\\-]+$') &&
        data.resourceType is string &&
        (data.resourceType == 'image' || data.resourceType == 'video') &&
        data.sizeBytes is int &&
        data.sizeBytes >= 1 &&
        data.sizeBytes <= 35000000 &&
        (!('durationSec' in data) || (data.durationSec is number && data.durationSec >= 0 && data.durationSec <= 7200)) &&
        data.status == 'active' &&
        isValidBoxWriteToken(boxId, data.pinToken) &&
        data.createdAt == request.time;
    }

    function isValidMediaSoftDelete(nextData, prevData, boxId) {
      return prevData.status == 'active' &&
        nextData.status == 'deleted' &&
        nextData.boxId == prevData.boxId &&
        nextData.id == prevData.id &&
        isValidBoxWriteToken(boxId, nextData.pinToken) &&
        nextData.diff(prevData).affectedKeys().hasOnly(['status', 'pinToken']);
    }

    function isValidSongLyricsCreate(data, boxId, lyricsId) {
      return data.keys().hasAll([
          'id',
          'boxId',
          'songTitle',
          'sourceType',
          'instrumental',
          'langMode',
          'lines',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'boxId',
          'songTitle',
          'artist',
          'sourceType',
          'instrumental',
          'langMode',
          'lines',
          'createdAt'
        ]) &&
        data.id is string &&
        data.id.size() >= 1 &&
        data.id.size() <= 128 &&
        data.id == lyricsId &&
        data.boxId is string &&
        data.boxId.size() >= 4 &&
        data.boxId.size() <= 64 &&
        data.boxId == boxId &&
        data.songTitle is string &&
        data.songTitle.size() >= 1 &&
        data.songTitle.size() <= 160 &&
        (!('artist' in data) || (data.artist is string && data.artist.size() <= 160)) &&
        data.sourceType is string &&
        (data.sourceType == 'audio' || data.sourceType == 'search') &&
        data.instrumental is bool &&
        data.langMode == 'bn-hinglish-en-v2' &&
        data.lines is list &&
        data.lines.size() <= 220 &&
        (data.lines.size() == 0 || (
          data.lines[0] is map &&
          data.lines[0].keys().hasAll(['startSec', 'endSec', 'text']) &&
          data.lines[0].keys().hasOnly(['startSec', 'endSec', 'text']) &&
          data.lines[0].startSec is number &&
          data.lines[0].endSec is number &&
          data.lines[0].text is string &&
          data.lines[0].text.size() <= 240
        )) &&
        data.createdAt == request.time &&
        (
          lyricsId.matches('^local_song_[a-f0-9]{24}$') ||
          (
            exists(/databases/$(database)/documents/chirkut_boxes/$(boxId)/media/$(lyricsId)) &&
            get(/databases/$(database)/documents/chirkut_boxes/$(boxId)/media/$(lyricsId)).data.kind == 'song' &&
            get(/databases/$(database)/documents/chirkut_boxes/$(boxId)/media/$(lyricsId)).data.status == 'active'
          )
        );
    }

    match /chirkut_boxes/{boxId} {
      allow get: if isValidId(boxId) && isSignedIn() && (request.auth.uid in resource.data.memberUids);
      allow list: if false;
      allow create: if isValidId(boxId) &&
        isSignedIn() &&
        !exists(/databases/$(database)/documents/chirkut_boxes/$(boxId)) &&
        isValidWorkspaceCreate(incoming(), boxId);
      allow update: if isValidId(boxId) &&
        isSignedIn() &&
        isAuthorizedLegacyBox(boxId) &&
        isValidWorkspaceCreate(incoming(), boxId);
      allow delete: if false;
    }

    match /user_workspaces/{uid} {
      allow get: if isValidId(uid) && isSignedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if isValidId(uid) &&
        isSignedIn() &&
        request.auth.uid == uid &&
        !exists(/databases/$(database)/documents/user_workspaces/$(uid)) &&
        isValidUserWorkspaceCreate(incoming(), uid) &&
        exists(/databases/$(database)/documents/chirkut_boxes/$(incoming().boxId)) &&
        (uid in get(/databases/$(database)/documents/chirkut_boxes/$(incoming().boxId)).data.memberUids);
      allow update: if isValidId(uid) &&
        isSignedIn() &&
        request.auth.uid == uid &&
        isValidUserWorkspaceCreate(incoming(), uid) &&
        exists(/databases/$(database)/documents/chirkut_boxes/$(incoming().boxId)) &&
        (uid in get(/databases/$(database)/documents/chirkut_boxes/$(incoming().boxId)).data.memberUids);
      allow delete: if false;
    }

    match /chirkut_boxes/{boxId}/notes/{noteId} {
      allow get: if isValidId(boxId) && isValidId(noteId) && isBoxMember(boxId);
      allow list: if isValidId(boxId) && isBoxMember(boxId) && resource.data.boxId == boxId;
      allow create: if isValidId(boxId) && isValidId(noteId) && isBoxMember(boxId) && isValidChirkutNoteCreate(incoming(), boxId, noteId);
      allow update: if isValidId(boxId) && isValidId(noteId) && isBoxMember(boxId) && isValidChirkutNoteUpdate(incoming(), existing(), boxId, noteId);
      allow delete: if isValidId(boxId) && isValidId(noteId) && isBoxMember(boxId) && ('status' in existing()) && existing().status == 'deleted';
    }

    match /chirkut_boxes/{boxId}/media/{mediaId} {
      allow get: if isValidId(boxId) && isValidId(mediaId) && isBoxMember(boxId);
      allow list: if isValidId(boxId) && isBoxMember(boxId) && resource.data.boxId == boxId;
      allow create: if isValidId(boxId) && isValidId(mediaId) && isBoxMember(boxId) && isValidMediaAssetCreate(incoming(), boxId, mediaId);
      allow update: if isValidId(boxId) && isValidId(mediaId) && isBoxMember(boxId) && isValidMediaSoftDelete(incoming(), existing(), boxId);
      allow delete: if isValidId(boxId) && isValidId(mediaId) && isBoxMember(boxId) && existing().status == 'deleted';
    }

    match /chirkut_boxes/{boxId}/song_lyrics/{lyricsId} {
      allow get: if isValidId(boxId) && isValidId(lyricsId) && isBoxMember(boxId);
      allow create: if isValidId(boxId) && isValidId(lyricsId) && isBoxMember(boxId) && isValidSongLyricsCreate(incoming(), boxId, lyricsId);
      allow update: if false;
      allow delete: if isValidId(boxId) && isValidId(lyricsId) && isBoxMember(boxId) && (
        !exists(/databases/$(database)/documents/chirkut_boxes/$(boxId)/media/$(lyricsId)) ||
        get(/databases/$(database)/documents/chirkut_boxes/$(boxId)/media/$(lyricsId)).data.status == 'deleted'
      );
    }
  }
}
